---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
};

const {
  href,
  external,
  underline = true,
  group = false,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  class={cn(
    "inline-block text-current transition-colors duration-200 ease-out hover:text-ink focus-visible:text-ink",
    underline &&
      "underline decoration-underline underline-offset-[3px] hover:decoration-ink focus-visible:decoration-ink",
    group && "group",
  )}
  {...rest}
>
  <slot />
</a>

---
type Props = {
  type?: "default" | "info" | "warning" | "error";
};
const { type = "default" } = Astro.props;
let emoji = "💡";
if (type === "info") {
  emoji = "ℹ️";
} else if (type === "warning") {
  emoji = "⚠️";
} else if (type === "error") {
  emoji = "🚨";
}

// The site has no accent colour, so callouts differentiate by their
// emoji and left rule weight rather than by hue.
const baseClasses =
  "relative my-6 flex rounded-sm border border-rule bg-paper-raised p-4 text-ink";
const typeClasses = {
  default: "border-l-2 border-l-ink-faint",
  info: "border-l-2 border-l-ink-faint",
  warning: "border-l-2 border-l-ink-muted",
  error: "border-l-2 border-l-ink",
};
---

<div class:list={["not-prose", baseClasses, typeClasses[type]]}>
  <span aria-hidden="true" class="pointer-events-none pr-3 text-xl select-none"
    >{emoji}</span
  >
  <slot />
</div>

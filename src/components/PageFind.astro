---
import Search from "astro-pagefind/components/Search";
---

<div data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    class="invisible fixed top-0 left-0 z-50 flex h-screen w-full justify-center bg-black/40 p-6 backdrop-blur-xs"
  >
    <div
      id="pagefind-container"
      role="dialog"
      aria-modal="true"
      aria-label="Search this site"
      class="border-rule bg-paper m-0 flex h-fit max-h-[80%] w-full max-w-(--measure) flex-col overflow-auto rounded-sm border p-2 px-4 py-3 shadow-lg"
    >
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          excerptLength: 15,
          resetStyles: false,
        }}
      />
      <div class="text-ink-faint mr-2 pt-4 pb-1 text-right font-sans text-xs">
        Press <kbd class="font-mono">Esc</kbd> or click anywhere to close
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const magnifyingGlass = document.getElementById("magnifying-glass");
  const backdrop = document.getElementById("backdrop");

  function openPagefind() {
    // Pagefind mounts its input from a deferred module script, so on a cold
    // load the input may not exist yet.
    const searchDiv = document.getElementById("search");
    setTimeout(() => {
      searchDiv?.querySelector("input")?.focus();
    }, 0);
    backdrop?.classList.remove("invisible");
    backdrop?.classList.add("visible");
  }

  function closePagefind() {
    const search = document.getElementById("search");
    search.value = "";
    backdrop?.classList.remove("visible");
    backdrop?.classList.add("invisible");
  }

  magnifyingGlass?.addEventListener("click", () => {
    openPagefind();
  });

  // Deliberately no bare `/` binding. WCAG SC 2.1.4 puts single-character
  // shortcuts in scope unless they can be turned off, remapped, or are live
  // only while their own component has focus, and a document-wide `/` is
  // none of those: speech input transcribes a stray utterance as the key and
  // the dialog opens unbidden. A modifier-bearing shortcut is out of scope.
  document.addEventListener("keydown", (e) => {
    // `!shiftKey` keeps Ctrl+Shift+K (Firefox's web console) out of this,
    // while `toLowerCase` still matches with Caps Lock on.
    if (
      (e.metaKey || e.ctrlKey) &&
      !e.shiftKey &&
      e.key.toLowerCase() === "k"
    ) {
      // Claim the chord in both states. Chrome and Firefox bind Cmd/Ctrl+K to
      // their own address bar, and macOS text fields read Ctrl+K as
      // delete-to-end-of-paragraph, so returning before this hands the key
      // to the browser and pulls focus out of the page entirely.
      e.preventDefault();
      // Reopening while it is already open would drag focus back to the
      // input from wherever the reader had moved it in the results.
      if (backdrop?.classList.contains("visible")) return;
      openPagefind();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closePagefind();
    }
  });

  document.addEventListener("click", (event) => {
    if (event.target.classList.contains("pagefind-ui__result-link")) {
      closePagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!event.target.closest("#pagefind-container")) {
      closePagefind();
    }
  });
</script>

<style is:global>
  /* Pagefind draws its own UI, so point its variables at the site tokens
     rather than letting it ship a palette of its own. */
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: "Geist Sans", ui-sans-serif, system-ui, sans-serif;
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink-muted);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule);
    --pagefind-ui-tag: var(--paper-raised);
  }

  #search input {
    font-weight: normal;
  }

  #search p {
    font-weight: normal;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
  }
</style>

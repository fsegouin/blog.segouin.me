---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<header transition:persist>
  <Container>
    <div
      class="border-rule flex items-center justify-between gap-4 border-b pb-4"
    >
      <a
        href="/"
        class="text-ink hover:decoration-ink focus-visible:decoration-ink font-serif text-base font-medium underline decoration-transparent underline-offset-[3px] transition-colors duration-200 ease-out"
      >
        {SITE.TITLE}
      </a>

      <nav aria-label="Main" class="flex items-center gap-4 sm:gap-5">
        <a
          href="/tags"
          class="text-ink-faint hover:text-ink focus-visible:text-ink font-sans text-sm transition-colors duration-200 ease-out"
          >Tags</a
        >

        <button
          id="magnifying-glass"
          aria-label="Search"
          class="text-ink-faint hover:bg-paper-raised hover:text-ink focus-visible:bg-paper-raised focus-visible:text-ink grid size-8 place-content-center rounded-sm transition-colors duration-200 ease-out"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="7" cy="7" r="4.25"></circle>
            <line x1="10.2" y1="10.2" x2="13.5" y2="13.5"></line>
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>

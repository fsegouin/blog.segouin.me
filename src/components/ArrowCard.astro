---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};
---

<a
  href={entry.collection === "blog" ? `/${entry.data.slug}` : `/${entry.collection}/${entry.id}`}
  class="not-prose group flex flex-nowrap border-b border-black/10 py-4 transition-colors duration-300 ease-in-out hover:text-black focus-visible:text-black dark:border-white/10 dark:hover:text-white dark:focus-visible:text-white"
>
  <div class="flex flex-1 flex-col gap-1">
    <div class="font-headline text-lg font-semibold leading-snug">
      {entry.data.title}
    </div>
    <div class="text-sm">
      {entry.data.description}
    </div>
    <div class="mt-1 text-xs opacity-50">
      {formatDate(entry.data.date)}
    </div>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="mt-1 size-5 shrink-0 fill-none stroke-current stroke-2 opacity-0 transition-opacity duration-300 ease-in-out group-hover:opacity-50 group-focus-visible:opacity-50"
  >
    <line x1="5" y1="12" x2="19" y2="12"></line>
    <polyline points="12 5 19 12 12 19"></polyline>
  </svg>
</a>

---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@lib/utils";

type Props = {
  entry: CollectionEntry<"blog">;
  headingLevel?: 2 | 3;
};

const { entry, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<a
  href={`/${entry.data.slug}`}
  class="group border-rule grid gap-x-8 gap-y-1 border-b py-5 sm:grid-cols-[6.5rem_1fr]"
>
  <time
    datetime={entry.data.date.toISOString()}
    class="text-ink-faint font-sans text-sm sm:pt-1"
  >
    {formatDate(entry.data.date)}
  </time>

  <div class="flex flex-col gap-1">
    <Heading
      class="text-ink group-hover:decoration-ink group-focus-visible:decoration-ink font-serif text-lg leading-snug font-medium underline decoration-transparent underline-offset-[3px] transition-colors duration-200 ease-out"
    >
      {entry.data.title}
    </Heading>
    <p class="text-ink-muted font-serif text-[0.95rem] leading-relaxed">
      {entry.data.description}
    </p>
  </div>
</a>

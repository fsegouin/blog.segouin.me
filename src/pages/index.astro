---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import type { CollectionEntry } from "astro:content";
import { getPublishedPosts } from "@lib/posts";

type PostsByYear = Record<string, CollectionEntry<"blog">[]>;

const posts = (await getPublishedPosts()).reduce((acc: PostsByYear, post) => {
  const year = post.data.date.getFullYear().toString();
  acc[year] ??= [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => Number(b) - Number(a));
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-14" data-pagefind-ignore>
      <h1 class="animate text-ink font-serif text-2xl font-medium italic">
        Working Draft.
      </h1>

      <div class="space-y-12">
        {
          years.map((year) => (
            <section class="animate">
              <h2 class="label border-rule border-b pb-3">{year}</h2>
              <ul class="not-prose flex flex-col">
                {posts[year].map((post) => (
                  <li>
                    <ArrowCard entry={post} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <section class="animate pt-6">
        <div class="border-rule border-b pb-3">
          <h2 class="label">Elsewhere</h2>
        </div>
        <ul class="not-prose mt-5 flex flex-wrap gap-x-5 gap-y-2">
          {
            SOCIALS.map((SOCIAL) => (
              <li>
                <Link
                  href={SOCIAL.HREF}
                  external
                  aria-label={`${SITE.TITLE} on ${SOCIAL.NAME} (opens in a new tab)`}
                >
                  <span class="font-sans text-sm">{SOCIAL.NAME}</span>
                </Link>
              </li>
            ))
          }
          <li>
            <Link
              href={`mailto:${SITE.EMAIL}`}
              aria-label={`Email ${SITE.TITLE}`}
            >
              <span class="font-sans text-sm">{SITE.EMAIL}</span>
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</Layout>

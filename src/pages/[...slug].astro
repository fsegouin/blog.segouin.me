---
import { type CollectionEntry, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { getPublishedPosts } from "@lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;

// `posts` is newest-first, so the entry after this one is the older post.
const posts = await getPublishedPosts();
const postIndex = posts.findIndex((p) => p.data.slug === post.data.slug);
const nextPost = postIndex === -1 ? undefined : posts[postIndex + 1];
const prevPost = postIndex === -1 ? undefined : posts[postIndex - 1];
const { Content, headings } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={`/og/${post.data.slug}.png`}
>
  <Container>
    <div class="animate">
      <BackToPrevious href="/">All posts</BackToPrevious>
    </div>
    <header class="mt-10 mb-12">
      <h1
        class="animate text-ink font-serif text-[2.125rem] leading-[1.15] font-semibold tracking-[-0.015em] text-balance sm:text-[2.625rem]"
      >
        {post.data.title}
      </h1>
      <div
        class="animate text-ink-faint mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-sans text-sm"
      >
        <FormattedDate date={post.data.date} />
        {
          post.body && (
            <>
              <span aria-hidden="true">·</span>
              <span>{readingTime(post.body)}</span>
            </>
          )
        }
        {
          post.data.tags?.map((tag) => (
            <>
              <span aria-hidden="true">·</span>
              <a
                href={`/tags/${tag}`}
                class="decoration-underline hover:text-ink hover:decoration-ink focus-visible:text-ink underline underline-offset-[3px] transition-colors duration-200 ease-out"
              >
                {tag}
              </a>
            </>
          ))
        }
      </div>
    </header>
    {
      post.data.toc !== false && headings.length > 0 && (
        <TableOfContents headings={headings} />
      )
    }
    <article class="animate">
      <Content />
      <div class="mt-24">
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />
      </div>
    </article>
  </Container>
</Layout>
